ENV=dev
PROJECT_NAME=ai_powered_order_assistant
PROJECT_VERSION=0.1.0
PROJECT_DESCRIPTION="An AI-powered conversational assistant for order processing data (NL-to-SQL)."
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8501
BASE_PATH=/ai_powered_order_assistant

# This project uses Gemini only (via langchain-google-genai) for intent detection,
# SQL generation, and response formatting.
GEMINI_API_KEY="your-gemini-api-key"

# Working directory for logs and the Hugging Face embedding model cache (default: current directory).
WORKING_DIR=

# Qdrant collection base name.
COLLECTION_NAME=ai_powered_order_assistant

# Hugging Face cache home (default: WORKING_DIR/<project>/hf).
HF_HOME=

# Qdrant (schema metadata RAG for SQL generation)
USE_QDRANT=true
USE_ORDER_DB=true
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_PROTOCOL=http

# Redis (SQL cache layer + multi-turn missing-parameter clarification memory)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PROTOCOL=redis

# Order Processing database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=order_processing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# NL-to-SQL assistant behavior
# Max wall-clock seconds allowed per SQL query before it is aborted.
SQL_QUERY_TIMEOUT_SECONDS=30
# Hard cap on rows returned per query.
SQL_QUERY_MAX_ROWS=200
# How long a cached NL-query -> SQL pair is reused before expiring.
SQL_CACHE_TTL_SECONDS=86400
# Qdrant collection used for the order-processing schema metadata (RAG).
ORDER_SCHEMA_COLLECTION_NAME=order_schema_metadata
